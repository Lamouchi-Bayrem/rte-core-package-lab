if(CMAKE_INSTALL_COMPONENT STREQUAL "Unspecified" OR NOT CMAKE_INSTALL_COMPONENT)
  if(EXISTS "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore/RteCoreTargets.cmake")
    file(DIFFERENT _cmake_export_file_changed FILES
         "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore/RteCoreTargets.cmake"
         "/workspace/embedded/embedded_package_config_lab/build/rte-core/CMakeFiles/Export/6b1b83dd5221a792422f2ea5518f7c9b/RteCoreTargets.cmake")
