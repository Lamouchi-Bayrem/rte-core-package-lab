      file(GLOB _cmake_old_config_files "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore/RteCoreTargets-*.cmake")
      if(_cmake_old_config_files)
        string(REPLACE ";" ", " _cmake_old_config_files_text "${_cmake_old_config_files}")
        message(STATUS "Old export file \"$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore/RteCoreTargets.cmake\" will be replaced.  Removing files [${_cmake_old_config_files_text}].")
        unset(_cmake_old_config_files_text)
        file(REMOVE ${_cmake_old_config_files})
      endif()
      unset(_cmake_old_config_files)
    endif()
    unset(_cmake_export_file_changed)
  endif()
  file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore" TYPE FILE FILES "/workspace/embedded/embedded_package_config_lab/build/rte-core/CMakeFiles/Export/6b1b83dd5221a792422f2ea5518f7c9b/RteCoreTargets.cmake")
  if(CMAKE_INSTALL_CONFIG_NAME MATCHES "^([Dd][Ee][Bb][Uu][Gg])$")
    file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore" TYPE FILE FILES "/workspace/embedded/embedded_package_config_lab/build/rte-core/CMakeFiles/Export/6b1b83dd5221a792422f2ea5518f7c9b/RteCoreTargets-debug.cmake")
  endif()
endif()

if(CMAKE_INSTALL_COMPONENT STREQUAL "Unspecified" OR NOT CMAKE_INSTALL_COMPONENT)
  file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/lib/cmake/RteCore" TYPE FILE FILES
    "/workspace/embedded/embedded_package_config_lab/build/rte-core/RteCoreConfig.cmake"
    "/workspace/embedded/embedded_package_config_lab/build/rte-core/RteCoreConfigVersion.cmake"
    )
